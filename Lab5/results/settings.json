  "initialization": "polynomials uniform(-0.1,0.1); ReLU [1,-.35,-1,1.3,.25,.25,.5] + uniform(-.04,.04)",
  "stopping": "full central-difference gradient infinity norm < 1e-5, checked every epoch",
  "history_every": 20,
