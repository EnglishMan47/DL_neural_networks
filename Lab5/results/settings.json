{
  "max_epochs": 3000,
  "seeds": [
    2026,
    2027,
    2028
  ],
  "penalties": [
    0.0,
    0.1,
    1.0
  ],
  "models": [
    "linear",
    "quadratic",
    "relu"
  ],
  "methods": [
    "gd",
    "sgd",
    "nesterov",
    "adam"
  ],
  "batch_sizes": [
    1,
    3,
    6,
    12
  ],
  "learning_rates": {
    "linear": {
      "gd": 0.02,
      "sgd": 0.005,
      "nesterov": 0.01,
      "adam": 0.02
    },
    "quadratic": {
      "gd": 0.01,
      "sgd": 0.0025,
      "nesterov": 0.01,
      "adam": 0.02
    },
    "relu": {
      "gd": 0.01,
      "sgd": 0.005,
